{
  "name": "jugnu",
  "private": true,
  "version": "0.1.0",
  "description": "Jugnu — finds the teachers who have cracked foundational learning in every block, learns what they do, and spreads it. AI for Foundational Learning Hackathon, Challenge 4.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "env:push": "node scripts/push-env.mjs",
    "ai:check": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/ai-check.ts",
    "credits": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/credits.ts",
    "eval": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/eval.ts",
    "build:vercel": "node scripts/vercel-build.mjs",
    "deploy:vercel": "node scripts/vercel-build.mjs && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@vercel/functions": "^3.10.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "framer-motion": "^13.4.4",
    "google-auth-library": "11.2.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "6.14.0",
    "postprocessing": "^6.39.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
