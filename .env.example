# Every setting here is optional. With this file as it is, Jugnu runs on its offline engine.

# ---- Claude. Without a key every AI task runs on the offline engine.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5                 # structured tasks; claude-haiku-5-5 or claude-sonnet-5-5
# AGENT_MODEL=claude-sonnet-5-5                 # the voice and chat assistant
# CREDIT_BUDGET_USD=500                         # spending limit for the app's own count of Claude use

# ---- Speech (Google Cloud Speech-to-Text Chirp 3 + Text-to-Speech Chirp 3 HD). Without it the browser's own voices are used.
# GOOGLE_CLOUD_API_KEY=                         # Text-to-Speech, and the fallback for Speech-to-Text
# GOOGLE_SERVICE_ACCOUNT_JSON=                  # Chirp 3 Speech-to-Text on a host; locally, a gcloud login also works
# GOOGLE_CLOUD_PROJECT=

# ---- Google Maps, read at build time, for the 3D district map. Without it Jugnu draws its own map.
# VITE_GOOGLE_MAPS_KEY=

# ---- Phone line: real outbound calls. There is no simulator — without a provider the Phone line tab is read-only.
# Exotel (India) — the ExoPhone must have a flow whose Voicebot applet points at
#   wss://<PUBLIC_URL>/api/ivr/exotel/stream?key=<webhook key from GET /api/ivr/setup>
# TELEPHONY_PROVIDER=exotel                   # exotel | plivo
# API_KEY_EXOTEL=
# API_TOKEN_PASSWORD=
# EXOTEL_SID=
# EXOTEL_HOST=api.exotel.com                  # api.in.exotel.com for the Mumbai cluster
# EXOTEL_FROM=0804xxxxxxx                     # your ExoPhone
# EXOTEL_APP_ID=                              # the flow id that carries the Voicebot applet
# Plivo (needs an Indian number on the account before it can dial Indian teachers; the demo calls use it)
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_FROM=
# PLIVO_APP_ID=
# PUBLIC_URL=https://your-deployment.example   # public https origin the provider can reach (a WebSocket is needed — not Vercel serverless)
# PHONE_SALT=change-me                          # salt for the one-way phone-number hash
# TEST_PHONE=+91xxxxxxxxxx                      # number offered by default in the dialer
# DEMO_TEACHER_PHONE=+91xxxxxxxxxx              # the only number the assistant may dial without being told one
# RECORD_CALLS=1                                # the team's own test calls only: keeps audio on this computer, in data/runtime/calls

# ---- WhatsApp (Meta WhatsApp Cloud API, free tier). Off until the token and phone number id are set.
# developers.facebook.com → your app → WhatsApp → API setup gives a test number, its phone number id
# and a temporary token; add up to 5 recipient numbers there while testing.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=any-long-random-string   # the same string goes in the webhook settings (callback: PUBLIC_URL/api/whatsapp/webhook)
# WHATSAPP_APP_SECRET=                           # app secret: incoming webhooks are signature-checked when set
# WHATSAPP_TEMPLATE=                             # an approved template with one body variable, for messages outside the 24-hour window
# WHATSAPP_TEMPLATE_LANG=hi
# WHATSAPP_API_VERSION=v23.0
# BEO_WHATSAPP=+91xxxxxxxxxx                     # optional: the BEO gets a WhatsApp line whenever work is escalated

# ---- Jugnu's clock on Vercel (vercel.json runs /api/cron/tick daily; the long-running server ticks every minute)
# CRON_SECRET=any-long-random-string

# ---- Storage. Defaults to data/runtime/jugnu.db.
# JUGNU_DB=/data/jugnu.db
# On Vercel, data lives in Turso (free). Adding Turso from the Vercel Marketplace sets these two.
# TURSO_DATABASE_URL=libsql://jugnu-<you>.turso.io
# TURSO_AUTH_TOKEN=
# API_PORT=8788
