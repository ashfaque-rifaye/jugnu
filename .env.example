# ---- Claude (the Build-stage credits). Without a key every AI task runs on the offline engine.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# ---- Officer-console passcode for a public demo link (teachers never need it — they use their link).
# DEMO_PASSCODE=

# ---- Phone line (Twilio). Without these the "Phone line" tab runs the same flow as a simulator.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# PUBLIC_URL=https://your-deployment.example   # where Twilio can reach /api/ivr/twilio/*
# PHONE_SALT=change-me                          # salt for the one-way phone-number hash

# ---- Storage. Defaults to data/runtime/jugnu.db; on Railway point it at a mounted volume.
# JUGNU_DB=/data/jugnu.db
# API_PORT=8788
